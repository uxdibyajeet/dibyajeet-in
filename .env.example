# Auth.js / NextAuth
# AUTH_SECRET: generate locally with `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
#   In production, set the same value on Vercel (or use `npx vercel env add`).
AUTH_SECRET=

# GitHub OAuth app credentials (github.com/settings/developers).
# Callback URL: http://localhost:3000/api/auth/callback/github in dev,
# https://<your-deploy>.vercel.app/api/auth/callback/github (and your custom domain) in prod.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Comma-separated GitHub usernames allowed to log in. Empty = any GitHub user.
ADMIN_GITHUB_USERS=

# Vercel Blob read/write token created in the Vercel dashboard
# (Storage -> Blob -> Create store). Required in production; without it the
# app falls back to local .data/ files for development.
BLOB_READ_WRITE_TOKEN=

# Redis credentials for the instant-read index. Two backends are auto-selected
# depending on which env vars are present:
#
#   1. Upstash REST (Vercel Marketplace / https://console.upstash.com):
#      UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN
#
#   2. RESP/TCP – Redis Cloud, local Redis, etc.:
#      REDIS_URL  (token is embedded in the URI; the Redis JSON module must be
#      enabled on the server).
#
# Without Redis the app reads case studies back from Blob directly (slower:
# Blob overwrites propagate with up to ~20s of eventual consistency).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# REDIS_URL=redis://default:<token>@<host>:<port>